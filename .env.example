# CareCore — Environment Variables
# Copy to .env.local for local development. NEVER commit .env.local.

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=["http://localhost:3001","http://localhost:3002"]

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://carecore:carecore_dev_password@localhost:5432/carecore

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=carecore_redis_dev

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_64_CHAR_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_SECRET
JWT_EXPIRY=900           # 15 minutes
JWT_REFRESH_EXPIRY=28800 # 8 hours

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 (use MinIO endpoint for local dev)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=carecore-documents
S3_ACCESS_KEY=carecore_minio
S3_SECRET_KEY=carecore_minio_dev

# SES (use MailHog SMTP for local dev)
SES_FROM_ADDRESS=noreply@carecore.co.uk
SES_ENDPOINT=http://localhost:1025

# ─── Search ───────────────────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200

# ─── IoT ──────────────────────────────────────────────────────────────────────
AWS_IOT_ENDPOINT=

# ─── External Integrations ────────────────────────────────────────────────────
NHS_SPINE_BASE_URL=
NHS_SPINE_CLIENT_ID=
NHS_SPINE_CLIENT_SECRET=

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_WEBHOOK_KEY=

# ─── Monitoring ───────────────────────────────────────────────────────────────
DATADOG_API_KEY=
SENTRY_DSN=
