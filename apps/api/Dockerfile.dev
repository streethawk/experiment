FROM node:20-alpine

# Required for Prisma migration engine on Alpine
RUN apk add --no-cache openssl openssl-dev libc6-compat

WORKDIR /app

# Install dependencies first (cached layer)
COPY package*.json ./
RUN npm install

# Copy Prisma schema and generate client
COPY prisma ./prisma
RUN npx prisma generate

# Copy source
COPY . .

EXPOSE 3000

CMD ["npm", "run", "dev"]
