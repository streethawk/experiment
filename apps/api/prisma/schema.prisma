// ─── Tenant Foundation ────────────────────────────────────────────────────────

model Organisation {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String           @db.VarChar(255)
  type                OrgType          @default(single_home)
  subscriptionTier    SubscriptionTier @default(starter) @map("subscription_tier")
  subscriptionStart   DateTime?        @map("subscription_start") @db.Date
  subscriptionEnd     DateTime?        @map("subscription_end") @db.Date
  billingEmail        String?          @map("billing_email") @db.VarChar(255)
  icoRegistrationRef  String?          @map("ico_registration_ref") @db.VarChar(50)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  homes               Home[]
  staff               Staff[]
  residents           Resident[]

  @@map("organisations")
}

model Home {
  id                       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId           String      @map("organisation_id") @db.Uuid
  name                     String      @db.VarChar(255)
  cqcRegistrationNumber    String?     @unique @map("cqc_registration_number") @db.VarChar(20)
  addressLine1             String      @map("address_line1") @db.VarChar(255)
  addressLine2             String?     @map("address_line2") @db.VarChar(255)
  city                     String      @db.VarChar(100)
  postcode                 String      @db.VarChar(10)
  phone                    String?     @db.VarChar(20)
  email                    String?     @db.VarChar(255)
  bedCapacity              Int         @map("bed_capacity") @db.SmallInt
  careTypes                CareTypeEnum[] @map("care_types")
  registeredManagerId      String?     @map("registered_manager_id") @db.Uuid
  lastCqcInspectionDate    DateTime?   @map("last_cqc_inspection_date") @db.Date
  lastCqcRating            CqcRating   @default(not_yet_rated) @map("last_cqc_rating")
  settings                 Json        @default("{}")
  createdAt                DateTime    @default(now()) @map("created_at")
  updatedAt                DateTime    @updatedAt @map("updated_at")
  deletedAt                DateTime?   @map("deleted_at")

  organisation             Organisation @relation(fields: [organisationId], references: [id])
  wings                    Wing[]
  rooms                    Room[]
  residents                Resident[]
  staff                    Staff[]
  incidents                Incident[]
  inventoryItems           InventoryItem[]
  invoices                 Invoice[]
  shifts                   Shift[]
  complianceAudits         ComplianceAudit[]

  @@map("homes")
}

model Wing {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  homeId      String  @map("home_id") @db.Uuid
  name        String  @db.VarChar(100)
  floor       Int?    @db.SmallInt
  description String? @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  home        Home    @relation(fields: [homeId], references: [id])
  rooms       Room[]

  @@map("wings")
}

model Room {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wingId      String   @map("wing_id") @db.Uuid
  homeId      String   @map("home_id") @db.Uuid
  roomNumber  String   @map("room_number") @db.VarChar(20)
  roomType    RoomType @default(single) @map("room_type")
  floor       Int?     @db.SmallInt
  bedCount    Int      @default(1) @map("bed_count") @db.SmallInt
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  wing        Wing     @relation(fields: [wingId], references: [id])
  home        Home     @relation(fields: [homeId], references: [id])
  residents   Resident[]

  @@unique([homeId, roomNumber])
  @@map("rooms")
}

// ─── Residents ────────────────────────────────────────────────────────────────

model Resident {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  homeId              String           @map("home_id") @db.Uuid
  organisationId      String           @map("organisation_id") @db.Uuid
  roomId              String?          @map("room_id") @db.Uuid

  fullName            String           @map("full_name") @db.VarChar(255)
  preferredName       String?          @map("preferred_name") @db.VarChar(100)
  dateOfBirth         DateTime         @map("date_of_birth") @db.Date
  gender              Gender?
  ethnicity           String?          @db.VarChar(100)
  religion            String?          @db.VarChar(100)
  firstLanguage       String?          @map("first_language") @db.VarChar(100)
  interpreterRequired Boolean          @default(false) @map("interpreter_required")
  photoS3Key          String?          @map("photo_s3_key") @db.VarChar(500)

  nhsNumber           String?          @map("nhs_number") @db.VarChar(10)
  gpName              String?          @map("gp_name") @db.VarChar(255)
  gpPractice          String?          @map("gp_practice") @db.VarChar(255)
  gpPhone             String?          @map("gp_phone") @db.VarChar(20)
  gpAddress           String?          @map("gp_address")

  status              ResidentStatus   @default(active)
  careType            ResidentCareType @map("care_type")
  admissionDate       DateTime         @map("admission_date") @db.Date
  admissionSource     AdmissionSource? @map("admission_source")
  dischargeDate       DateTime?        @map("discharge_date") @db.Date
  dischargeTo         String?          @map("discharge_to") @db.VarChar(100)
  dischargeReason     String?          @map("discharge_reason")
  keyworkerId         String?          @map("keyworker_id") @db.Uuid

  primaryFundingSource FundingSourceType @default(self_funded) @map("primary_funding_source")

  dnarInPlace         Boolean          @default(false) @map("dnar_in_place")
  dnarSignedDate      DateTime?        @map("dnar_signed_date") @db.Date
  mcaLacksCapacity    Boolean?         @map("mca_lacks_capacity")

  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  home                Home             @relation(fields: [homeId], references: [id])
  organisation        Organisation     @relation(fields: [organisationId], references: [id])
  room                Room?            @relation(fields: [roomId], references: [id])
  contacts            ResidentContact[]
  allergies           Allergy[]
  diagnoses           Diagnosis[]
  dolsRecords         DolsRecord[]
  mcaAssessments      McaAssessment[]
  carePlans           CarePlan[]
  riskAssessments     RiskAssessment[]
  medications         Medication[]
  marEntries          MarEntry[]
  careNotes           CareNote[]
  wounds              Wound[]
  incidents           Incident[]
  vitals              Vital[]
  vitalTargets        VitalTarget?
  contracts           ResidentContract[]
  fundingSources      FundingSource[]
  invoices            Invoice[]

  @@map("residents")
}

model ResidentContact {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  residentId          String   @map("resident_id") @db.Uuid
  name                String   @db.VarChar(255)
  relationship        String   @db.VarChar(100)
  phonePrimary        String?  @map("phone_primary") @db.VarChar(20)
  phoneSecondary      String?  @map("phone_secondary") @db.VarChar(20)
  email               String?  @db.VarChar(255)
  address             String?
  isPrimaryNok        Boolean  @default(false) @map("is_primary_nok")
  hasLpaWelfare       Boolean  @default(false) @map("has_lpa_welfare")
  hasLpaFinance       Boolean  @default(false) @map("has_lpa_finance")
  isFamilyPortalUser  Boolean  @default(false) @map("is_family_portal_user")
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  resident            Resident @relation(fields: [residentId], references: [id])

  @@map("resident_contacts")
}

model Allergy {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  residentId  String          @map("resident_id") @db.Uuid
  substance   String          @db.VarChar(255)
  reaction    String
  severity    AllergySeverity
  notes       String?
  recordedBy  String          @map("recorded_by") @db.Uuid
  recordedAt  DateTime        @default(now()) @map("recorded_at")
  isActive    Boolean         @default(true) @map("is_active")

  resident    Resident        @relation(fields: [residentId], references: [id])

  @@map("allergies")
}

// ─── Care Plans ───────────────────────────────────────────────────────────────

model CarePlan {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  residentId      String        @map("resident_id") @db.Uuid
  homeId          String        @map("home_id") @db.Uuid
  version         Int           @default(1) @db.SmallInt
  status          CarePlanStatus @default(draft)
  sections        Json          @default("{}")
  createdBy       String        @map("created_by") @db.Uuid
  approvedBy      String?       @map("approved_by") @db.Uuid
  approvedAt      DateTime?     @map("approved_at")
  nextReviewDate  DateTime?     @map("next_review_date") @db.Date
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  resident        Resident      @relation(fields: [residentId], references: [id])

  @@map("care_plans")
}

model RiskAssessment {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  residentId  String     @map("resident_id") @db.Uuid
  homeId      String     @map("home_id") @db.Uuid
  type        RiskType
  score       Int?       @db.SmallInt
  riskLevel   RiskLevel  @map("risk_level")
  details     Json       @default("{}")
  assessedBy  String     @map("assessed_by") @db.Uuid
  assessedAt  DateTime   @map("assessed_at")
  validUntil  DateTime?  @map("valid_until") @db.Date
  createdAt   DateTime   @default(now()) @map("created_at")

  resident    Resident   @relation(fields: [residentId], references: [id])

  @@map("risk_assessments")
}

// ─── Medications & MAR ────────────────────────────────────────────────────────

model Medication {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  residentId          String              @map("resident_id") @db.Uuid
  homeId              String              @map("home_id") @db.Uuid
  drugName            String              @map("drug_name") @db.VarChar(255)
  form                String?             @db.VarChar(100)
  strength            String?             @db.VarChar(50)
  dose                String              @db.VarChar(100)
  route               MedicationRoute
  frequency           MedicationFrequency
  times               DateTime[]          @db.Time
  indication          String?
  instructions        String?
  isPrn               Boolean             @default(false) @map("is_prn")
  prnCriteria         String?             @map("prn_criteria")
  isControlledDrug    Boolean             @default(false) @map("is_controlled_drug")
  controlledDrugSchedule Int?            @map("controlled_drug_schedule") @db.SmallInt
  prescribedBy        String?             @map("prescribed_by") @db.VarChar(255)
  prescribedDate      DateTime?           @map("prescribed_date") @db.Date
  reviewDate          DateTime?           @map("review_date") @db.Date
  stockOnHand         Decimal?            @map("stock_on_hand") @db.Decimal(10, 2)
  status              MedicationStatus    @default(active)
  discontinuedDate    DateTime?           @map("discontinued_date") @db.Date
  discontinuedBy      String?             @map("discontinued_by") @db.Uuid
  discontinuedReason  String?             @map("discontinued_reason")
  createdBy           String              @map("created_by") @db.Uuid
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  resident            Resident            @relation(fields: [residentId], references: [id])
  marEntries          MarEntry[]
  cdRegister          ControlledDrugRegister[]

  @@map("medications")
}

model MarEntry {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  medicationId    String      @map("medication_id") @db.Uuid
  residentId      String      @map("resident_id") @db.Uuid
  homeId          String      @map("home_id") @db.Uuid
  scheduledTime   DateTime    @map("scheduled_time")
  administeredAt  DateTime?   @map("administered_at")
  outcome         MarOutcome
  administeredBy  String      @map("administered_by") @db.Uuid
  witnessId       String?     @map("witness_id") @db.Uuid
  notes           String?
  isPrn           Boolean     @default(false) @map("is_prn")
  prnIndication   String?     @map("prn_indication")
  createdAt       DateTime    @default(now()) @map("created_at")

  medication      Medication  @relation(fields: [medicationId], references: [id])
  resident        Resident    @relation(fields: [residentId], references: [id])

  @@map("mar_entries")
}

// ─── Care Notes ───────────────────────────────────────────────────────────────

model CareNote {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  residentId    String              @map("resident_id") @db.Uuid
  homeId        String              @map("home_id") @db.Uuid
  shift         CareNoteShift
  categories    CareNoteCategory[]
  note          String
  moodScore     Int?                @map("mood_score") @db.SmallInt
  foodIntakePct Int?                @map("food_intake_pct") @db.SmallInt
  fluidIntakeMl Int?                @map("fluid_intake_ml") @db.SmallInt
  isFlagged     Boolean             @default(false) @map("is_flagged")
  flagReason    String?             @map("flag_reason")
  editHistory   Json                @default("[]") @map("edit_history")
  createdBy     String              @map("created_by") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  deletedAt     DateTime?           @map("deleted_at")

  resident      Resident            @relation(fields: [residentId], references: [id])
  attachments   CareNoteAttachment[]

  @@map("care_notes")
}

model CareNoteAttachment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  careNoteId  String   @map("care_note_id") @db.Uuid
  s3Key       String   @map("s3_key") @db.VarChar(500)
  filename    String   @db.VarChar(255)
  contentType String?  @map("content_type") @db.VarChar(100)
  sizeBytes   Int?     @map("size_bytes")
  createdBy   String   @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  careNote    CareNote @relation(fields: [careNoteId], references: [id])

  @@map("care_note_attachments")
}

// ─── Incidents ────────────────────────────────────────────────────────────────

model Incident {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  homeId            String          @map("home_id") @db.Uuid
  organisationId    String          @map("organisation_id") @db.Uuid
  reference         String          @unique @db.VarChar(30)
  type              IncidentType
  severity          IncidentSeverity @default(low)
  status            IncidentStatus   @default(open)
  residentId        String?          @map("resident_id") @db.Uuid
  occurredAt        DateTime         @map("occurred_at")
  location          String?          @db.VarChar(100)
  description       String
  immediateActions  String[]         @map("immediate_actions")
  injurySustained   Boolean          @default(false) @map("injury_sustained")
  injuryDescription String?          @map("injury_description")
  familyNotified    Boolean          @default(false) @map("family_notified")
  gpNotified        Boolean          @default(false) @map("gp_notified")
  cqcNotifiable     Boolean          @default(false) @map("cqc_notifiable")
  rootCause         String?          @map("root_cause")
  actionsTaken      Json             @default("[]") @map("actions_taken")
  reportedBy        String           @map("reported_by") @db.Uuid
  reportedAt        DateTime         @default(now()) @map("reported_at")
  closedAt          DateTime?        @map("closed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  home              Home             @relation(fields: [homeId], references: [id])
  resident          Resident?        @relation(fields: [residentId], references: [id])
  witnesses         IncidentWitness[]

  @@map("incidents")
}

model IncidentWitness {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidentId  String   @map("incident_id") @db.Uuid
  staffId     String?  @map("staff_id") @db.Uuid
  name        String   @db.VarChar(255)
  statement   String?
  createdAt   DateTime @default(now()) @map("created_at")

  incident    Incident @relation(fields: [incidentId], references: [id])

  @@map("incident_witnesses")
}

// ─── Staff ────────────────────────────────────────────────────────────────────

model Staff {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organisationId      String         @map("organisation_id") @db.Uuid
  homeId              String         @map("home_id") @db.Uuid
  userId              String?        @unique @map("user_id") @db.Uuid
  fullName            String         @map("full_name") @db.VarChar(255)
  email               String         @unique @db.VarChar(255)
  phone               String?        @db.VarChar(20)
  role                StaffRole
  employmentType      EmploymentType @map("employment_type")
  contractedHoursPw   Decimal?       @map("contracted_hours_pw") @db.Decimal(5, 2)
  startDate           DateTime       @map("start_date") @db.Date
  endDate             DateTime?      @map("end_date") @db.Date
  status              StaffStatus    @default(active)
  dbsType             String?        @map("dbs_type") @db.VarChar(50)
  dbsCertificateNo    String?        @map("dbs_certificate_no") @db.VarChar(20)
  dbsIssueDate        DateTime?      @map("dbs_issue_date") @db.Date
  dbsOutcome          String?        @map("dbs_outcome") @db.VarChar(20)
  rightToWorkChecked  Boolean        @default(false) @map("right_to_work_checked")
  nmcPin              String?        @map("nmc_pin") @db.VarChar(20)
  nmcExpiry           DateTime?      @map("nmc_expiry") @db.Date
  createdAt           DateTime       @default(now()) @map("created_at")
