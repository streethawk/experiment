// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String    @unique @db.VarChar(255)
  fullName              String    @map("full_name") @db.VarChar(255)
  role                  UserRole
  organisationId        String?   @map("organisation_id") @db.Uuid
  homeIds               String[]  @map("home_ids") @db.Uuid
  staffId               String?   @unique @map("staff_id") @db.Uuid
  residentId            String?   @map("resident_id") @db.Uuid

  // Credentials
  passwordHash          String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt       DateTime? @map("email_verified_at")
  passwordResetToken    String?   @map("password_reset_token") @db.VarChar(255)
  passwordResetExpiry   DateTime? @map("password_reset_expiry")

  // Account state
  isActive              Boolean   @default(true) @map("is_active")
  failedLoginCount      Int       @default(0) @map("failed_login_count") @db.SmallInt
  lockedUntil           DateTime? @map("locked_until")
  lastLoginAt           DateTime? @map("last_login_at")
  lastLoginIp           String?   @map("last_login_ip") @db.VarChar(45)

  // MFA
  mfaEnabled            Boolean   @default(false) @map("mfa_enabled")
  mfaSecret             String?   @map("mfa_secret") @db.VarChar(255)

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  refreshTokens         RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @map("token_hash") @db.VarChar(255) // bcrypt hash of the raw token
  deviceId    String?   @map("device_id") @db.VarChar(255)  // for "trust this device"
  isTrusted   Boolean   @default(false) @map("is_trusted")   // skips MFA if true
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  ipAddress   String?   @map("ip_address") @db.VarChar(45)
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

