// CareCore — Prisma Schema
// PostgreSQL 16, UK data residency (AWS eu-west-2)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "fullTextSearch"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, pg_trgm, uuidOssp(map: "uuid-ossp")]
}

